# Quant Terminal Environment Configuration

# Application Settings
APP_NAME="Quant Terminal"
APP_VERSION="0.1.0"
DEBUG=false
LOG_LEVEL=INFO

# Server Settings
HOST=0.0.0.0
PORT=8000

# Trading Mode: paper | ths | tdx | qmt | ctp | okx
TRADE_MODE=paper

# TDX Configuration
TDX_SERVER=119.147.212.81:7709
TDX_USER=
TDX_PASSWORD=

# OKX Configuration
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
OKX_SIMULATED=true

# Risk Management
MAX_POSITION_PCT=0.8
MAX_SINGLE_ORDER_PCT=0.1
MAX_DAILY_LOSS_PCT=0.05
ENABLE_RISK_CHECK=true

# Data Storage
DUCKDB_PATH=./data/quant_terminal.duckdb
DATA_CACHE_DIR=./data/cache

# AI Model
MODEL_PATH=./models
ENABLE_AI_PREDICTION=false

# GPU Settings
CUDA_VISIBLE_DEVICES=0
USE_GPU=false

# WebSocket
WS_HEARTBEAT_INTERVAL=30

# External APIs
TUSHARE_TOKEN=
AKSHARE_NO_CACHE=true
